# judge：Python gRPC 判题服务
# 02 号票：一次性容器沙箱（ADR-0003）——本镜像加装 docker-cli，compose 挂载
# 宿主 docker.sock（docker-out-of-docker）；沙箱镜像 python:3.12-slim 在服务
# 启动时预拉（构建期无 daemon，见 server.py ensure_sandbox_image）
FROM python:3.13-slim
# Debian 13 (trixie) 已把 Docker 拆包：docker.io 只含 daemon，CLI 在 docker-cli。
# judge 经挂载的 docker.sock 使用宿主 daemon，自己不跑 dockerd——只装 CLI。
RUN apt-get update && apt-get install -y --no-install-recommends docker-cli \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /srv
COPY judge/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY judge/ .
EXPOSE 50051
CMD ["python", "-m", "judgesvc.server"]
